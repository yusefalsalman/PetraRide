# Base URL of the PetraVoice Laravel API (no trailing slash)
VITE_BACKEND_URL=http://localhost:8000

# true  -> never call the backend, always use mock responses
# false -> call the backend, fall back to mock data if it is unreachable
VITE_USE_MOCK=false

# Request timeout for /api/voice-process in milliseconds
VITE_API_TIMEOUT_MS=15000
